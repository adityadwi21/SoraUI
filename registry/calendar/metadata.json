{
  "name": "calendar",
  "type": "registry:ui",
  "level": 3,
  "description": "An accessible, zero-dependency monthly date calendar with keyboard grid navigation and range limits.",
  "props": {
    "value": { "type": "Date" },
    "defaultValue": { "type": "Date" },
    "minDate": { "type": "Date" },
    "maxDate": { "type": "Date" }
  },
  "accessibility": {
    "keyboard": [
