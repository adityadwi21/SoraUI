      "role=\"gridcell\"",
      "aria-selected",
      "aria-disabled"
    ],
    "focus": "Full roving tabindex on calendar grid cells"
  },
  "files": [{ "path": "components/ui/calendar.tsx", "type": "registry:ui" }],
  "dependencies": [],
  "installation": {
    "cli": "npx soraui add calendar",
    "npm": "import { Calendar } from '@soraui/react'"
  }
}
