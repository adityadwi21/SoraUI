{
  "name": "combobox",
  "type": "registry:ui",
  "level": 3,
  "description": "Autocomplete input component with real-time filtering, keyboard navigation, and active descendant ARIA support.",
  "props": {
    "options": { "type": "ComboboxOption[]", "required": true },
    "value": { "type": "string" },
    "defaultValue": { "type": "string" },
    "placeholder": { "type": "string", "default": "Search..." },
    "emptyText": { "type": "ReactNode", "default": "No options found." }
  },
  "accessibility": {
    "keyboard": ["ArrowDown/ArrowUp to cycle highlighted options", "Enter to select option", "Escape to dismiss"],
    "aria": ["role=\"combobox\"", "role=\"listbox\"", "role=\"option\"", "aria-autocomplete=\"list\"", "aria-activedescendant"],
    "focus": "Focus stays in input while active descendant changes"
  },
  "files": [{ "path": "components/ui/combobox.tsx", "type": "registry:ui" }],
  "dependencies": ["@soraui/hooks"],
  "installation": { "cli": "npx soraui add combobox", "npm": "import { Combobox } from '@soraui/react'" }
}