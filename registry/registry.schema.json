{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SoraUIRegistry",
  "type": "object",
  "required": ["version", "components", "blocks", "templates"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "enum": [1] },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "level", "description", "tags", "files"],
        "properties": {
          "name": { "type": "string" },
          "level": { "type": "integer", "enum": [1, 2, 3] },
          "description": { "type": "string" },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "path"],
              "properties": {
                "name": { "type": "string" },
                "path": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "blocks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "name", "category", "description", "dependencies"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["auth", "dashboard", "marketing", "forms"]
          },
          "description": { "type": "string" },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "preview": {
            "type": "object",
            "properties": {
              "desktop": { "type": "boolean" },
              "mobile": { "type": "boolean" }
            }
          }
        }
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "description",
          "blocks",
          "dependencies"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["auth", "dashboard", "marketing", "settings"]
          },
          "description": { "type": "string" },
          "blocks": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "preview": {
            "type": "object",
            "properties": {
              "desktop": { "type": "boolean" },
              "mobile": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
