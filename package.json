{
  "name": "soraui",
  "version": "0.0.0",
  "private": true,
  "description": "SoraUI — Open-source lightweight UI construction system for JavaScript and TypeScript applications.",
  "repository": {
    "type": "git",
    "url": "https://github.com/soraui/soraui"
  },
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:a11y": "turbo run test:a11y",
    "test:contract": "turbo run test:contract",
    "test:browser": "playwright test --config=playwright.config.ts tests/browser-compat",
    "test:visual": "playwright test --config=playwright.config.ts tests/visual-regression",
    "test:visual:update": "playwright test --config=playwright.config.ts tests/visual-regression --update-snapshots",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\"",
    "verify:rc": "node scripts/verify-release-candidate.mjs"
  },

  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4"
  },

  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
