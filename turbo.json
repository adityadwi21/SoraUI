{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:a11y": {
      "dependsOn": ["^build"]
    },
    "test:contract": {
      "dependsOn": ["^build"]
    },
    "test:browser": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:visual": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["test-results/**", "tests/visual-regression/__snapshots__/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
