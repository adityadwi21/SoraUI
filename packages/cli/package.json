{
  "name": "@soraui/cli",
  "version": "0.1.0-rc.1",

  "publishConfig": {
    "access": "public",
    "tag": "rc"
  },

  "description": "SoraUI CLI — Add accessible UI components, blocks, and themes to your project from the canonical registry",

  "license": "MIT",
  "author": "SoraUI Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/soraui/soraui.git"
  },
  "keywords": [
    "soraui",
    "cli",
    "ui",
    "components",
    "blocks",
    "themes",
    "generator"
  ],
  "type": "module",

  "bin": {
    "soraui": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node -e \"fs.copyFileSync('../../registry/registry.json', 'src/utils/canonical-registry.json')\"",
    "build": "tsup",
    "dev": "tsup --watch",
    "pretypecheck": "node -e \"fs.copyFileSync('../../registry/registry.json', 'src/utils/canonical-registry.json')\"",
    "typecheck": "tsc --noEmit",
    "pretest": "node -e \"fs.copyFileSync('../../registry/registry.json', 'src/utils/canonical-registry.json')\"",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },

  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}