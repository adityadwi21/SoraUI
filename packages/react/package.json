{
  "name": "@soraui/react",
  "version": "0.1.0",
  "description": "SoraUI React — Accessible, lightweight, customizable React components",
  "license": "MIT",
  "author": "SoraUI Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/soraui/soraui.git"
  },
  "keywords": [
    "soraui",
    "react",
    "ui-components",
    "design-system",
    "accessibility",
    "axe",
    "wcag",
    "tailwind-free"
  ],
  "type": "module",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/styles.css",
    "./styles.css": "./dist/styles.css",
    "./dist/styles.css": "./dist/styles.css",
    "./dist/index.css": "./dist/styles.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@soraui/core": "workspace:*",
    "@soraui/hooks": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/react": "^4.13.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.0.5",
    "axe-core": "^4.13.0",
    "esbuild": "^0.27.7",
    "jsdom": "^24.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "vitest-axe": "^0.1.0"
  }
}