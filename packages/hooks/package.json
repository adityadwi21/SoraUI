{
  "name": "@soraui/hooks",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "description": "SoraUI reusable React hooks",

  "license": "MIT",
  "author": "SoraUI Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/adityadwi21/SoraUI.git",
    "directory": "packages/hooks"
  },
  "keywords": [
    "soraui",
    "react-hooks",
    "use-focus-trap",
    "use-portal",
    "use-escape-key",
    "use-click-outside"
  ],
  "type": "module",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  }
}